nextflow_workflow {

    name "Test PROCESS_FOLDER"
    script "subworkflows/local/process_folder.nf"
    
    test("PROCESS_FOLDER correctly loads an Illumina folder without pipeline worksheet") {

        workflow "PROCESS_FOLDER"

        when {
            params {
                ignore_metadata = true
            }
            workflow {
                """
                input[0] = "${baseDir}/tests/input/Illumina"
                """
            }
        }

        then {
            assert workflow.success

            def reads = workflow.out.reads
            assert reads.size() == 3 
            assert reads.get(0).size() == 4

            for (int n in 1..3) {
                assert reads.get(n-1)[0].keySet() == ["id"].toSet()
                assert reads.get(n-1)[0].id == "idx${n}"
                assert reads.get(n-1)[1].endsWith("${n}_S${n}_L001_R1_001.fastq.gz")
                assert reads.get(n-1)[2].endsWith("${n}_S${n}_L001_R2_001.fastq.gz")
                assert reads.get(n-1)[3] == ''
            }
        }
    }

    test("PROCESS_FOLDER correctly loads an Illumina folder with pipeline worksheet") {

        workflow "PROCESS_FOLDER"

        when {
            workflow {
                """
                input[0] = "${baseDir}/tests/input/Illumina"
                """
            }
        }

        then {
            assert workflow.success

            def reads = workflow.out.reads
            assert reads.size() == 3 
            assert reads.get(0).size() == 4

            for (int n in 1..3) {
                assert reads.get(n-1)[0].keySet() == ['id', 'control', 'accession', 'organism'].toSet()
                assert reads.get(n-1)[0].id == "idx${n}"
                assert reads.get(n-1)[0].accession == "${n}${n}-${n}${n}${n}-${n}${n}${n}${n}${n}" 
                assert reads.get(n-1)[1].endsWith("${n}_S${n}_L001_R1_001.fastq.gz")
                assert reads.get(n-1)[2].endsWith("${n}_S${n}_L001_R2_001.fastq.gz")
                assert reads.get(n-1)[3] == ''
            }
        }
    }

    test("PROCESS_FOLDER correctly loads a Nanopore folder without pipeline worksheet") {

        workflow "PROCESS_FOLDER"

        when {            
            params {
                ignore_metadata = true
            }
            workflow {
                """
                input[0] = "${baseDir}/tests/input/Nanopore"
                """
            }
        }

        then {
            assert workflow.success

            def reads = workflow.out.reads
            assert reads.size() == 3 
            assert reads.get(0).size() == 4

            for (int n in 1..3) {
                assert reads.get(n-1)[0].keySet() == ["id"].toSet()
                assert reads.get(n-1)[0].id == "idx${n}"
                assert reads.get(n-1)[1] == ''
                assert reads.get(n-1)[2] == ''
                assert reads.get(n-1)[3].size() == 3
                for (int m in 0..2) {
                    assert reads.get(n-1)[3][m].endsWith("FAV00000_pass_barcode0${n}_AAAAAAAA_${m}.fastq.gz")
                }

                //endsWith("FAV00000_pass_barcode0${n}_AAAAAAAA_0.fastq.gz")
            }
        }
    }

    test("PROCESS_FOLDER correctly loads a Nanopore folder with pipeline worksheet") {

        workflow "PROCESS_FOLDER"

        when {
            workflow {
                """
                input[0] = "${baseDir}/tests/input/Nanopore"
                """
            }
        }

        then {
            assert workflow.success

            def reads = workflow.out.reads
            assert reads.size() == 3 
            assert reads.get(0).size() == 4

            for (int n in 1..3) {
                assert reads.get(n-1)[0].keySet() == ['id', 'control', 'accession', 'organism'].toSet()
                assert reads.get(n-1)[0].id == "idx${n}"
                assert reads.get(n-1)[0].accession == "${n}${n}-${n}${n}${n}-${n}${n}${n}${n}${n}" 
                assert reads.get(n-1)[1] == ''
                assert reads.get(n-1)[2] == ''
                assert reads.get(n-1)[3].size() == 3
                for (int m in 0..2) {
                    assert reads.get(n-1)[3][m].endsWith("FAV00000_pass_barcode0${n}_AAAAAAAA_${m}.fastq.gz")
                }
            }
        }
    }

    test("PROCESS_FOLDER fails when loading a non-existing folder") {

        workflow "PROCESS_FOLDER"

        when {
            workflow {
                """
                input[0] = "${baseDir}/tests/input/Not/A/folder"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Cannot find input folder")
        }
    }

    test("PROCESS_FOLDER fails when no files are found") {

        workflow "PROCESS_FOLDER"

        def emptyDir =""

        setup {
            emptyDir = new File("${launchDir}/emptyDir")
            emptyDir.mkdirs()
        }

        when {

            workflow {
                """
                input[0] = "${emptyDir}"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("No FASTQ files found")
        }
    }
}


