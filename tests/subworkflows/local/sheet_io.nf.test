nextflow_workflow {

    name "Test IMPORT_SHEET"
    script "subworkflows/local/sheet_io.nf"       

    test("IMPORT_SHEET correctly loads Illumina and ONT samples") {       

        workflow "IMPORT_SHEET"

        def samplesheetPath =""

        setup {
            samplesheetPath = file("${baseDir}/tests/input/samplesheet.csv").absolutePath
        }

        when {
            params {
                incols = "short1,short2,long"
            }

            workflow {  
                """              
                input[0] = file("${samplesheetPath}")
                """
            }
        }

        then {
            assert workflow.success

            // Check that reads has correct structure
            def reads = workflow.out.reads // Cannot use with (workflow.out), as $baseDir will fail to resolve
            assert reads.size() == 3            // 3 samples
            assert reads.get(0).size() == 4     // 4 cols: meta, short1, short1, long

            // Check that reads are correct
            //def fileRows = samplesheetPath.readLines().tail()*.split(',') //TODO: get these values directly from the imported CSV
            for (int n in 1..3) {
                assert reads.get(n-1)[0].id == "idx${n}"
                assert reads.get(n-1)[0].accession == "${n}${n}-${n}${n}${n}-${n}${n}${n}${n}${n}" 
                assert reads.get(n-1)[1].endsWith("${n}_S${n}_L001_R1_001.fastq.gz")
                assert reads.get(n-1)[2].endsWith("${n}_S${n}_L001_R2_001.fastq.gz")
                assert reads.get(n-1)[3].endsWith("FAV00000_pass_barcode0${n}_AAAAAAAA_0.fastq.gz")
            }
        }
    }

    test("IMPORT_SHEET fails when samplesheet is missing") {       

        workflow "IMPORT_SHEET"

        when {
            workflow {  
                """              
                input[0] = file("/not/a/real/path")
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Cannot find samplesheet")
        }
    }

    test("IMPORT_SHEET fails when ID column is missing") {       

        workflow "IMPORT_SHEET"

        def samplesheetPath = ""

        setup {
            def samplesheet = file("${workDir}/samplesheet.csv")
            samplesheet.text = """\
            sample,short1,short2,long
            s1,file1_s1.fastq.gz,file2_s1.fastq.gz,file3_s1.fastq.gz
            s2,file1_s2.fastq.gz,file2_s2.fastq.gz,file3_s2.fastq.gz
            s3,file1_s3.fastq.gz,file2_s3.fastq.gz,file3_s3.fastq.gz
            """.stripIndent()

            samplesheetPath = samplesheet.absolutePath
        }

        when {
            workflow {  
                """              
                input[0] = file("${samplesheetPath}")
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Missing `id` column in samplesheet")
        }
    }

    test("IMPORT_SHEET fails when incols are missing") {       

        workflow "IMPORT_SHEET"

        def samplesheetPath = ""

        setup {
            def samplesheet = file("${workDir}/samplesheet.csv")
            samplesheet.text = """\
            id,found1,found2,missing
            s1,f1.fq.gz,f2.fq.gz,f3.fq.gz
            """.stripIndent()

            samplesheetPath = samplesheet.absolutePath
        }

        when {

            params {
                incols = "found1,found2,found3"
            }

            workflow {  
                """              
                input[0] = file("${samplesheetPath}")
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Missing --incols in samplesheet")
        }
    }

    test("EXPORT_SHEET correctly exports Illumina samples") {

        workflow "EXPORT_SHEET"

        when {
            params {
                outdir = "results"
                label = "fastq"
                outcols = "short1,short2,long"
            }
            
            workflow {
                """   
                input[0] = Channel.fromList([
                            [ [ id:'idx1', accession:"11-111-11111" ], // meta map
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode01/FAV00000_pass_barcode01_AAAAAAAA.fastq.gz") ],
                            [ [ id:'idx2', accession:"22-222-22222" ], // meta map
                                file("${baseDir}/tests/input/Illumina/2_S2_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/2_S2_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode02/FAV00000_pass_barcode02_AAAAAAAA.fastq.gz") ],
                            [ [ id:'idx3', accession:"33-333-33333" ], // meta map
                                file("${baseDir}/tests/input/Illumina/3_S3_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/3_S3_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode03/FAV00000_pass_barcode03_AAAAAAAA.fastq.gz") ]
                        ]).toList()
                """
            }
        }

        then {
            assert workflow.success

            assert workflow.out.samplesheet != null
            assert workflow.out.samplesheet.size() == 1 
            def filename = workflow.out.samplesheet.get(0)

            def lines = path(filename).toFile().readLines().findAll { !it.trim().isEmpty() }
            def headers = lines[0].split(',').collect { it.trim() }
            assert headers == ["id","accession","short1","short2","long"]

            lines.tail().eachWithIndex { row, n -> 
                def vals = row.split(',')
                def i = n+1
                assert vals[0] == "idx${i}"
                assert vals[1] == "${i}${i}-${i}${i}${i}-${i}${i}${i}${i}${i}"
                assert vals[2] == "${baseDir}/tests/input/Illumina/${i}_S${i}_L001_R1_001.fastq.gz"
                assert vals[3] == "${baseDir}/tests/input/Illumina/${i}_S${i}_L001_R2_001.fastq.gz"
                assert vals[4] == "${baseDir}/tests/input/Nanopore/barcode0${i}/FAV00000_pass_barcode0${i}_AAAAAAAA.fastq.gz"
            }
        }
    }

    test("EXPORT_SHEET fails when too many output cols") {

        workflow "EXPORT_SHEET"

        when {
            params {
                outdir = "results"
                label = "fastq"
                outcols = "short1,short2,long,extra"
            }
            
            workflow {
                """   
                input[0] = Channel.fromList([
                            [ [ id:'idx1', accession:"11-111-11111" ], // meta map
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode01/FAV00000_pass_barcode01_AAAAAAAA.fastq.gz") ]
                        ]).toList()
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Incorrect --outcols columns")
        }
    }

    test("EXPORT_SHEET fails when too few output cols") {

        workflow "EXPORT_SHEET"

        when {
            params {
                outdir = "results"
                label = "fastq"
                outcols = "short1,short2"
            }
            
            workflow {
                """   
                input[0] = Channel.fromList([
                            [ [ id:'idx1', accession:"11-111-11111" ], // meta map
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode01/FAV00000_pass_barcode01_AAAAAAAA.fastq.gz") ]
                        ]).toList()
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Incorrect --outcols columns")
        }
    }

    test("EXPORT_SHEET fails when missing ID col") {

        workflow "EXPORT_SHEET"

        when {
            params {
                outdir = "results"
                label = "fastq"
            }
            
            workflow {
                """   
                input[0] = Channel.fromList([
                            [ [ not_id:'idx1', accession:"11-111-11111" ], // meta map
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R1_001.fastq.gz"), 
                                file("${baseDir}/tests/input/Illumina/1_S1_L001_R2_001.fastq.gz"),
                                file("${baseDir}/tests/input/Nanopore/barcode01/FAV00000_pass_barcode01_AAAAAAAA.fastq.gz") ]
                        ]).toList()
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.stderr.join('; ').contains("Missing `id` col in output metadata")
        }
    }
}
